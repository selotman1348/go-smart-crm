# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase -----------------------------------------------------------------
# Hosted project: Supabase dashboard > Project Settings > API Keys.
# Local stack (`npm run db:start`): values from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server-only: used by
# the seed script and the e2e test clean-up. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Supabase CLI access token (sbp_...), for npm run db:push / db:types against the
# hosted project. Dashboard > Account > Access Tokens; limit it to this project
# (database read/write, projects read) if offered. CLI only; never NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=

# --- E-mail (iteration 4) ----------------------------------------------------
# Shared secret of the inbound webhook /api/inbound-email: the provider calls
# https://<any-user>:<secret>@<host>/api/inbound-email (HTTP Basic). Without it
# every webhook call is refused. Generate a long random value.
INBOUND_EMAIL_SECRET=
# Postmark server token for outbound e-mail. Leave empty to record e-mails on
# the case without delivering them (development, tests).
POSTMARK_SERVER_TOKEN=
# Sender of outbound e-mails; must be a confirmed sender signature in Postmark.
EMAIL_FROM=Go Smart CRM <cases@gosmart.example>
# Printed on the repair order (BR-09).
COMPANY_NAME=Go Smart
INVOICING_EMAIL=invoices@gosmart.example

# --- Event webhooks (iteration 5, docs/api.md) --------------------------------
# Where /api/events/dispatch posts business events, and the HMAC secret it
# signs them with. Leave empty to keep events in the database only.
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/events/dispatch.
CRON_SECRET=

# --- Seed and end-to-end tests ------------------------------------------------
# Password given to the fictitious users created by `npm run db:seed`.
SEED_USER_PASSWORD=
# Seeded user the Playwright tests sign in as (password: SEED_USER_PASSWORD).
E2E_USER_EMAIL=alex.morgan@gosmart.example
