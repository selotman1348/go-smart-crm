# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase -----------------------------------------------------------------
# Hosted project: Supabase dashboard > Project Settings > API Keys.
# Local stack (`npm run db:start`): values from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server-only: used by
# scripts/seed.ts to create users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Seed and end-to-end tests ------------------------------------------------
# Password given to the fictitious users created by `npm run db:seed`.
SEED_USER_PASSWORD=
# Seeded user the Playwright tests sign in as (password: SEED_USER_PASSWORD).
E2E_USER_EMAIL=alex.morgan@gosmart.example
